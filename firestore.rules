rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity Validators
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email']) &&
             data.keys().hasOnly(['uid', 'email', 'displayName', 'avatar', 'role', 'createdAt', 'updatedAt']) &&
             data.uid is string && data.uid.size() <= 128 && data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 256;
    }

    function isValidChatMessage(data) {
      return data.keys().hasAll(['userId', 'role', 'text']) &&
             data.keys().hasOnly(['id', 'userId', 'role', 'text', 'modelUsed', 'createdAt']) &&
             data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid &&
             data.role in ['user', 'model', 'system'] &&
             data.text is string && data.text.size() <= 20000;
    }

    function isValidTaskShare(data) {
      return data.keys().hasAll(['taskId', 'ownerId', 'inviteeEmail', 'role']) &&
             data.keys().hasOnly(['id', 'taskId', 'taskTitle', 'ownerId', 'inviteeEmail', 'inviteeName', 'role', 'status', 'createdAt']) &&
             data.taskId is string && data.taskId.size() <= 128 &&
             data.ownerId is string && data.ownerId.size() <= 128 &&
             data.inviteeEmail is string && data.inviteeEmail.size() <= 256 &&
             data.role in ['collaborator', 'reviewer', 'observer'];
    }

    function isValidContact(data) {
      return data.keys().hasAll(['userId', 'name', 'email']) &&
             data.keys().hasOnly(['id', 'userId', 'name', 'email', 'avatar', 'organization', 'createdAt']) &&
             data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid &&
             data.name is string && data.name.size() <= 128 &&
             data.email is string && data.email.size() <= 256;
    }

    function isValidTaskBlueprint(data) {
      return data.keys().hasAll(['id', 'name', 'category', 'tasks']) &&
             data.keys().hasOnly(['id', 'name', 'description', 'category', 'tasks', 'isCustom', 'createdAt', 'authorName', 'authorId']) &&
             data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 128 &&
             data.category in ['work', 'creative', 'engineering', 'research', 'personal'] &&
             data.tasks is list;
    }

    function isValidTask(data) {
      return data.keys().hasAll(['id', 'title', 'prompt', 'status', 'priority', 'creatorId']) &&
             data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 240 &&
             data.prompt is string && data.prompt.size() <= 10000 &&
             data.creatorId is string && data.creatorId == request.auth.uid &&
             data.priority in ['low', 'medium', 'high', 'critical'];
    }

    // Collections
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId);
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId && isValidUser(incoming());
      allow update: if isSignedIn() && isValidId(userId) && request.auth.uid == userId && isValidUser(incoming()) && incoming().uid == existing().uid;
    }

    match /chat_messages/{messageId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(messageId) && isValidChatMessage(incoming());
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    match /task_shares/{shareId} {
      allow get: if isSignedIn() && (resource.data.ownerId == request.auth.uid || resource.data.inviteeEmail == request.auth.token.email);
      allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || resource.data.inviteeEmail == request.auth.token.email);
      allow create: if isSignedIn() && isValidId(shareId) && incoming().ownerId == request.auth.uid && isValidTaskShare(incoming());
      allow update: if isSignedIn() && (existing().ownerId == request.auth.uid || existing().inviteeEmail == request.auth.token.email) && isValidTaskShare(incoming()) && incoming().taskId == existing().taskId && incoming().ownerId == existing().ownerId;
      allow delete: if isSignedIn() && existing().ownerId == request.auth.uid;
    }

    match /contacts/{contactId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(contactId) && isValidContact(incoming());
      allow update: if isSignedIn() && existing().userId == request.auth.uid && isValidContact(incoming()) && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    match /task_blueprints/{blueprintId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(blueprintId) && isValidTaskBlueprint(incoming()) && incoming().authorId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(blueprintId) && isValidTaskBlueprint(incoming()) && resource.data.authorId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }

    match /tasks/{taskId} {
      allow get, list: if isSignedIn() && resource.data.creatorId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(taskId) && isValidTask(incoming());
      allow update: if isSignedIn() && isValidId(taskId) && resource.data.creatorId == request.auth.uid && isValidTask(incoming()) && incoming().creatorId == existing().creatorId;
      allow delete: if isSignedIn() && resource.data.creatorId == request.auth.uid;
    }
  }
}
